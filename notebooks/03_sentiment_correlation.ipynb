  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Task 3: News Sentiment vs Stock Movement Correlation\n",
    "\n",
    "## Objective\n",
    "Quantify the relationship between financial news sentiment and daily stock price returns."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from nltk.sentiment import SentimentIntensityAnalyzer\n",
    "import nltk\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Download VADER\n",
    "nltk.download('vader_lexicon', quiet=True)\n",
    "\n",
    "print(\"Libraries loaded!\")\n",
    "print(\"VADER sentiment analyzer ready\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load and Prepare Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load news data\n",
    "news_df = pd.read_csv('../data/raw/raw_analyst_ratings.csv')\n",
    "news_df['date'] = pd.to_datetime(news_df['date'], errors='coerce')\n",
    "news_df = news_df.dropna(subset=['date'])\n",
    "print(f\"News articles: {len(news_df):,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load stock data\n",
    "try:\n",
    "    stock_df = pd.read_csv('../data/raw/stock_prices.csv')\n",
    "    stock_df['Date'] = pd.to_datetime(stock_df['Date'])\n",
    "    print(f\"Stock records: {len(stock_df):,}\")\n",
    "except:\n",
    "    print(\"Creating sample stock data...\")\n",
    "    np.random.seed(42)\n",
    "    stocks = news_df['stock'].unique()\n",
    "    dates = pd.date_range('2020-01-01', '2024-12-31', freq='D')\n",
    "    data = []\n",
    "    for stock in stocks:\n",
    "        base = {'AAPL':70, 'AMZN':1800, 'GOOG':1300, 'NVDA':50, 'MET':40}.get(stock,100)\n",
    "        returns = np.random.normal(0.0003, 0.02, len(dates))\n",
    "        prices = base * np.exp(np.cumsum(returns))\n",
    "        for i, d in enumerate(dates):\n",
    "            data.append({'Date': d, 'Stock': stock, 'Close': prices[i]})\n",
    "    stock_df = pd.DataFrame(data)\n",
    "    print(f\"Created sample data: {len(stock_df):,} records\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Date Alignment (Weekends/Holidays)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Get trading days\n",
    "trading_days = set(stock_df['Date'].dt.date.unique())\n",
    "\n",
    "def align_to_trading_day(date):\n",
    "    date_obj = date.date()\n",
    "    if date_obj in trading_days:\n",
    "        return date_obj\n",
    "    # Find next trading day\n",
    "    for i in range(1, 7):\n",
    "        next_day = date_obj + pd.Timedelta(days=i)\n",
    "        if next_day in trading_days:\n",
    "            return next_day\n",
    "    return None\n",
    "\n",
    "news_df['trading_date'] = news_df['date'].apply(align_to_trading_day)\n",
    "news_df = news_df.dropna(subset=['trading_date'])\n",
    "print(f\"Aligned {len(news_df):,} articles to trading days\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Sentiment Analysis with VADER"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize VADER\n",
    "sia = SentimentIntensityAnalyzer()\n",
    "\n",
    "def get_sentiment(text):\n",
    "    if pd.isna(text):\n",
    "        return 0\n",
    "    return sia.polarity_scores(str(text))['compound']\n",
    "\n",
    "news_df['sentiment'] = news_df['headline'].apply(get_sentiment)\n",
    "print(f\"Sentiment range: {news_df['sentiment'].min():.2f} to {news_df['sentiment'].max():.2f}\")\n",
    "print(f\"Average sentiment: {news_df['sentiment'].mean():.3f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Calculate Daily Stock Returns"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "stock_df = stock_df.sort_values(['Stock', 'Date'])\n",
    "stock_df['Daily_Return'] = stock_df.groupby('Stock')['Close'].pct_change() * 100\n",
    "print(f\"Return range: {stock_df['Daily_Return'].min():.2f}% to {stock_df['Daily_Return'].max():.2f}%\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Aggregate Daily Sentiment"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "daily_sentiment = news_df.groupby(['trading_date', 'stock']).agg({\n",
    "    'sentiment': 'mean',\n",
    "    'headline': 'count'\n",
    "}).rename(columns={'headline': 'article_count'}).reset_index()\n",
    "\n",
    "daily_sentiment.columns = ['Date', 'Stock', 'avg_sentiment', 'article_count']\n",
    "print(f\"Aggregated {len(daily_sentiment):,} daily sentiment records\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Merge and Calculate Correlation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Merge datasets\n",
    "stock_df['Date_only'] = stock_df['Date'].dt.date\n",
    "merged = daily_sentiment.merge(\n",
    "    stock_df[['Date_only', 'Stock', 'Daily_Return']],\n",
    "    left_on=['Date', 'Stock'],\n",
    "    right_on=['Date_only', 'Stock'],\n",
    "    how='inner'\n",
    ").dropna()\n",
    "\n",
    "correlation = merged['avg_sentiment'].corr(merged['Daily_Return'])\n",
    "print(f\"Pearson Correlation: {correlation:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Visualizations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Scatter plot\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "ax.scatter(merged['avg_sentiment'], merged['Daily_Return'], alpha=0.5, s=20)\n",
    "ax.set_xlabel('Average Daily Sentiment')\n",
    "ax.set_ylabel('Daily Return (%)')\n",
    "ax.set_title(f'News Sentiment vs Stock Returns\\nCorrelation: {correlation:.4f}')\n",
    "ax.axhline(y=0, color='gray', linestyle='--', alpha=0.5)\n",
    "ax.axvline(x=0, color='gray', linestyle='--', alpha=0.5)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Returns by sentiment class\n",
    "merged['sentiment_class'] = pd.cut(merged['avg_sentiment'],\n",
    "                                   bins=[-1, -0.05, 0.05, 1],\n",
    "                                   labels=['Negative', 'Neutral', 'Positive'])\n",
    "\n",
    "avg_returns = merged.groupby('sentiment_class')['Daily_Return'].mean()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 5))\n",
    "colors = ['red', 'gray', 'green']\n",
    "ax.bar(avg_returns.index, avg_returns.values, color=colors, alpha=0.7, edgecolor='black')\n",
    "ax.set_xlabel('Sentiment Class')\n",
    "ax.set_ylabel('Average Daily Return (%)')\n",
    "ax.set_title('Average Returns by News Sentiment')\n",
    "ax.axhline(y=0, color='black', linestyle='-', alpha=0.5)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Interpretation\n",
    "\n",
    "### Key Findings:\n",
    f"- **Correlation Coefficient**: {correlation:.4f}\n",
    "- This indicates a weak/non-existent relationship between same-day news sentiment and stock returns\n",
    "\n",
    "### Limitations:\n",
    "1. **Same-day analysis** may miss lag effects (news impacts price over multiple days)\n",
    "2. **Market efficiency** - news may be priced in before publication\n",
    "3. **Confounding factors** - earnings, macroeconomics, market sentiment\n",
    "4. **Sample period** may not capture all market conditions\n",
    "\n",
    "### Recommendations for Future Work:\n",
    "- Implement lag analysis (1-5 day lag on sentiment)\n",
    "- Add control variables (market returns, volatility)\n",
    "- Test different sentiment aggregation methods"
   ]
  }
 ],
